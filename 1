# ==========================================
# ЗАДАЧА 1. Игра "Лабиринт"
# ==========================================

# Исходные данные (пример лабиринта 5x5)
# 0 - проход, 1 - стена, л - ловушка, м - монета, ф - выход, з - враг, н - начальная точка
labyrinth = "н001м1л1ф1м1з1м010м1л1м0"

# ------------------------------------------
# Задание 1.1: Вывести лабиринт (5 строк по 5 символов)
# ------------------------------------------
print("--- Задание 1.1: Лабиринт ---")
for i in range(0, 25, 5):
    # Используем срез для получения строки из 5 символов
    row = labyrinth[i:i+5]
    print(row)

# ------------------------------------------
# Задание 1.2: Найти координаты входа 'н'
# ------------------------------------------
print("\n--- Задание 1.2: Координаты входа ---")
# Метод find() возвращает индекс первого вхождения
index_entry = labyrinth.find('н')
# Вычисляем строку и столбец (нумерация с 0)
row_entry = index_entry // 5
col_entry = index_entry % 5
print(f"Вход 'н' находится в строке {row_entry}, столбце {col_entry}")

# ------------------------------------------
# Задание 1.3: Найти координаты выхода 'ф'
# ------------------------------------------
print("\n--- Задание 1.3: Координаты выхода ---")
index_exit = labyrinth.find('ф')
row_exit = index_exit // 5
col_exit = index_exit % 5
print(f"Выход 'ф' находится в строке {row_exit}, столбце {col_exit}")

# ------------------------------------------
# Задание 1.4: Расстояние между входом и выходом
# ------------------------------------------
print("\n--- Задание 1.4: Расстояние ---")
# Формула манхэттенского расстояния
distance = abs(row_entry - row_exit) + abs(col_entry - col_exit)
print(f"Расстояние между входом и выходом: {distance} шагов")

# ------------------------------------------
# Задание 1.5: Подсчет монет 'м'
# ------------------------------------------
print("\n--- Задание 1.5: Монеты ---")
count_coins = labyrinth.count('м')
# Выводим в формате "🟡x2" или "🟡🟡"
print(f"Собрано монет: {'🟡' * count_coins} (всего {count_coins})")

# ------------------------------------------
# Задание 1.6: Подсчет здоровья (HP)
# ------------------------------------------
print("\n--- Задание 1.6: Здоровье ---")
health = 100
# Подсчитываем урон
count_traps = labyrinth.count('л')
count_enemies = labyrinth.count('з')
damage = count_traps * 10 + count_enemies * 50
health -= damage

# Формируем визуализацию: полное сердце = 10 HP, пустое = 10 потерянных HP
full_hearts = health // 10
empty_hearts = damage // 10
# Выводим с использованием Unicode-символов
print(f"Осталось здоровья: {health} HP")
print(f"Визуализация: {'❤' * full_hearts}{'♡' * empty_hearts}")

# ------------------------------------------
# Задание 1.7: Замена символов на эмодзи
# ------------------------------------------
print("\n--- Задание 1.7: Лабиринт с эмодзи ---")
# Словарь для замены
replacements = {
    '0': '⬜',  # белый квадрат
    '1': '⬛',  # черный квадрат
    'л': '🔷',  # синий ромб
    'м': '🟡',  # желтый круг
    'ф': '🟫',  # коричневый квадрат
    'з': '🐷',  # свинья
    'н': '⭐'   # звезда
}

# Заменяем символы. Так как мы используем одиночные символы,
# можно пройтись циклом или использовать метод replace.
# Используем цепочку replace для наглядности.
emoji_labyrinth = labyrinth
for symbol, emoji in replacements.items():
    emoji_labyrinth = emoji_labyrinth.replace(symbol, emoji)

# Выводим по 5 символов (эмодзи могут занимать больше места, но логика срезов сохраняется)
# В Python эмодзи - это один символ, поэтому len() корректно работает
for i in range(0, len(emoji_labyrinth), 5):
    print(emoji_labyrinth[i:i+5])
