# ==========================================
# ЗАДАЧА 2. Симулятор фермы
# ==========================================

# ------------------------------------------
# Этап 1: База растений
# ------------------------------------------
print("\n=== ЭТАП 1: База растений ===")

# Пример входных данных (строка с растениями)
farm_data = "Роза красный средний быстрый, Тюльпан желтый крупный медленный, Кактус зеленый малый средний"

# Разделяем строку на отдельные растения по запятой и пробелу
plants_raw = farm_data.split(', ')
plants = []

print("Растения на ферме:")
for plant_str in plants_raw:
    # Разделяем характеристики растения по пробелу
    parts = plant_str.split()
    name = parts[0]
    color = parts[1]
    size = parts[2]
    growth = parts[3]
    
    # Сохраняем в список (можно в виде словаря или кортежа)
    plants.append({'name': name, 'color': color, 'size': size, 'growth': growth})
    print(f"{name} {color} {size} {growth}")

# ------------------------------------------
# Этап 2: Проверка возможности скрещивания
# ------------------------------------------
print("\n=== ЭТАП 2: Проверка скрещивания ===")

# Список возможных гибридов (пример)
hybrids_data = "Роза+Тюльпан=РозаТюльпан;Кактус+Тюльпан=КактусТюльпан"

# Запрашиваем у пользователя названия двух растений для скрещивания
parent1 = input("Введите название первого растения: ")
parent2 = input("Введите название второго растения: ")

# Ищем гибрид в списке
# Разбиваем строку гибридов по точке с запятой
hybrid_records = hybrids_data.split(';')
found_hybrid = None

for record in hybrid_records:
    # Разбиваем запись на части: "Родитель1+Родитель2=Гибрид"
    if '=' in record:
        parents_part, hybrid_name = record.split('=')
        # Разбиваем родителей по плюсу
        p1, p2 = parents_part.split('+')
        
        # Проверяем совпадение (порядок не важен)
        if (p1 == parent1 and p2 == parent2) or (p1 == parent2 and p2 == parent1):
            found_hybrid = hybrid_name
            break

if found_hybrid:
    print(f"Получен гибрид: *{found_hybrid}*")
else:
    print("Эти растения нельзя скрестить")

# ------------------------------------------
# Этап 3.1: Определение цвета гибрида
# ------------------------------------------
print("\n=== ЭТАП 3.1: Цвет гибрида ===")

# Пример данных родителей (в реальной задаче вводятся пользователем, но для демонстрации используем словарь)
parent1_name = "Роза"
parent1_color = "красный"
parent2_name = "Тюльпан"
parent2_color = "желтый"

# Правило: гибрид получает цвет того растения, чье название идет раньше в алфавитном порядке.
# Для сравнения используем метод lower() для корректного сравнения регистра
if parent1_name.lower() < parent2_name.lower():
    hybrid_color = parent1_color
elif parent2_name.lower() < parent1_name.lower():
    hybrid_color = parent2_color
else:
    # Если названия одинаковые, берем цвет первого
    hybrid_color = parent1_color

print(f"Цвет гибрида: {hybrid_color}")

# ------------------------------------------
# Этап 3.2: Определение размера гибрида
# ------------------------------------------
print("\n=== ЭТАП 3.2: Размер гибрида ===")

# Размеры родителей
parent1_size = "средний"
parent2_size = "крупный"

# Правило: если размеры одинаковые - наследует его.
# Если разные - записываем оба через /, начиная с меньшего.
# Порядок: малый < средний < крупный
size_order = ["малый", "средний", "крупный"]

if parent1_size == parent2_size:
    hybrid_size = parent1_size
else:
    # Определяем, какой размер меньше
    idx1 = size_order.index(parent1_size)
    idx2 = size_order.index(parent2_size)
    
    if idx1 < idx2:
        hybrid_size = f"{parent1_size}/{parent2_size}"
    else:
        hybrid_size = f"{parent2_size}/{parent1_size}"

print(f"Размер гибрида: {hybrid_size}")

# ------------------------------------------
# Этап 3.3: Определение скорости роста гибрида
# ------------------------------------------
print("\n=== ЭТАП 3.3: Скорость роста ===")

# Скорости родителей
parent1_growth = "быстрый"
parent2_growth = "медленный"

# Правило: гибрид наследует наименьшую скорость из двух.
# Порядок: медленный < средний < быстрый
growth_order = ["медленный", "средний", "быстрый"]

# Находим индекс каждой скорости
idx_g1 = growth_order.index(parent1_growth)
idx_g2 = growth_order.index(parent2_growth)

# Берем минимальный индекс (наименьшая скорость)
min_idx = min(idx_g1, idx_g2)
hybrid_growth = growth_order[min_idx]

print(f"Скорость роста гибрида: {hybrid_growth}")
